    <!-- Offline Privacy Policy Dialog -->
    <string name="privacy_title">Arquitectura de privacidad 100% sin conexión</string>
    <string name="privacy_summary">BoxVault está diseñado desde cero sin dependencias de la nube. Sus datos de inventario son estrictamente de su propiedad y nunca salen de su dispositivo físico.</string>
    <string name="privacy_pillar_db_title">Base de datos SQLite 100% local en el dispositivo</string>
    <string name="privacy_pillar_db_desc">Cada caja, cantidad de artículos, categoría y referencia de foto se almacena exclusivamente en la base de datos Room SQLite privada de la app en su dispositivo.</string>
    <string name="privacy_pillar_network_title">Cero permisos de red</string>
    <string name="privacy_pillar_network_desc">android.permission.INTERNET está estrictamente eliminado (tools:node=\"remove\") en AndroidManifest.xml. El sistema operativo Android prohíbe físicamente que BoxVault realice conexiones de red salientes.</string>
    <string name="privacy_pillar_accounts_title">Sin cuentas, sin rastreo ni sincronización en la nube</string>
    <string name="privacy_pillar_accounts_desc">Sin registros de correo, sin contraseñas, sin cuentas en la nube y sin SDK de analítica o telemetría. El escáner QR utiliza modelos de ML Kit sin conexión integrados.</string>
    <string name="privacy_pillar_backup_title">Copias de seguridad privadas locales en archivo SAF</string>
    <string name="privacy_pillar_backup_desc">Las copias de seguridad son archivos .ZIP portátiles exportados estrictamente mediante el Storage Access Framework (SAF) de Android a una carpeta local o unidad externa elegida por usted.</string>
    <string name="privacy_understood">Entendido</string>

