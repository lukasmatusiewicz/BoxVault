    <!-- Offline Privacy Policy Dialog -->
    <string name="privacy_title">Architecture de confidentialité 100% hors ligne</string>
    <string name="privacy_summary">BoxVault est conçu dès le départ sans aucune dépendance au cloud. Vos données d\'inventaire vous appartiennent exclusivement et ne quittent jamais votre appareil physique.</string>
    <string name="privacy_pillar_db_title">Base de données SQLite 100% locale sur l\'appareil</string>
    <string name="privacy_pillar_db_desc">Chaque boîte, quantité d\'articles, catégorie et référence photo est stockée exclusivement dans votre base locale Room SQLite privée.</string>
    <string name="privacy_pillar_network_title">Zéro permission réseau</string>
    <string name="privacy_pillar_network_desc">android.permission.INTERNET est strictement supprimé (tools:node=\"remove\") dans AndroidManifest.xml. Le système Android interdit physiquement toute connexion sortante.</string>
    <string name="privacy_pillar_accounts_title">Aucun compte, aucun suivi, aucune synchronisation cloud</string>
    <string name="privacy_pillar_accounts_desc">Pas d\'inscription par e-mail, pas de mot de passe, pas de compte cloud et aucun SDK d\'analyse ou télémétrie. Le scanner QR utilise les modèles hors ligne intégrés de ML Kit.</string>
    <string name="privacy_pillar_backup_title">Sauvegardes d\'archives locales privées SAF</string>
    <string name="privacy_pillar_backup_desc">Les sauvegardes sont des archives .ZIP portables exportées uniquement via le Storage Access Framework (SAF) d\'Android vers le dossier de votre choix.</string>
    <string name="privacy_understood">Compris</string>

