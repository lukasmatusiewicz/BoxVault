    <!-- Offline Privacy Policy Dialog -->
    <string name="privacy_title">Architettura di privacy 100% offline</string>
    <string name="privacy_summary">BoxVault è progettato da zero senza dipendenze dal cloud. I tuoi dati di inventario sono esclusivamente di tua proprietà e non lasciano mai il tuo dispositivo fisico.</string>
    <string name="privacy_pillar_db_title">Database SQLite 100% locale sul dispositivo</string>
    <string name="privacy_pillar_db_desc">Ogni scatola, quantità di articoli, categoria e riferimento fotografico è memorizzato esclusivamente nel database privato Room SQLite sulla memoria del dispositivo.</string>
    <string name="privacy_pillar_network_title">Zero permessi di rete</string>
    <string name="privacy_pillar_network_desc">android.permission.INTERNET è rigorosamente rimosso (tools:node=\"remove\") in AndroidManifest.xml. Il sistema operativo Android impedisce a BoxVault qualsiasi connessione in uscita.</string>
    <string name="privacy_pillar_accounts_title">Nessun account, tracciamento o sincronizzazione cloud</string>
    <string name="privacy_pillar_accounts_desc">Nessuna registrazione e-mail, nessuna password, nessun account cloud e nessun SDK di analisi o telemetria. Lo scanner QR utilizza modelli ML Kit offline integrati.</string>
    <string name="privacy_pillar_backup_title">Backup privati locali SAF</string>
    <string name="privacy_pillar_backup_desc">I backup sono archivi .ZIP portabili esportati esclusivamente tramite lo Storage Access Framework (SAF) di Android verso una cartella locale o unità esterna a tua scelta.</string>
    <string name="privacy_understood">Ho capito</string>

