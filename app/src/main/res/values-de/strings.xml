    <!-- Offline Privacy Policy Dialog -->
    <string name="privacy_title">100% Offline-Datenschutzarchitektur</string>
    <string name="privacy_summary">BoxVault wurde von Grund auf ohne Cloud-Abhängigkeiten entwickelt. Ihre Inventardaten sind ausschließlich Ihr Eigentum und verlassen niemals Ihr physisches Gerät.</string>
    <string name="privacy_pillar_db_title">100% lokale SQLite-Datenbank auf dem Gerät</string>
    <string name="privacy_pillar_db_desc">Jede Box, Artikelmenge, Kategorie und Fotoreferenz wird ausschließlich in Ihrer app-privaten lokalen Room-SQLite-Datenbank auf Ihrem Gerätespeicher gespeichert.</string>
    <string name="privacy_pillar_network_title">Keine Netzwerkberechtigungen</string>
    <string name="privacy_pillar_network_desc">android.permission.INTERNET wurde strikt entfernt (tools:node=\"remove\") in AndroidManifest.xml. Das Android-Betriebssystem verbietet BoxVault physisch jegliche ausgehende Netzwerkverbindung.</string>
    <string name="privacy_pillar_accounts_title">Keine Konten, kein Tracking, keine Cloud-Synchronisierung</string>
    <string name="privacy_pillar_accounts_desc">Keine E-Mail-Registrierung, keine Passwörter, keine Cloud-Konten und keine Telemetrie/Analytics-SDKs. Der QR-Scanner nutzt gebündelte Offline-Modelle von ML Kit.</string>
    <string name="privacy_pillar_backup_title">Private lokale SAF-Archiv-Backups</string>
    <string name="privacy_pillar_backup_desc">Backups sind portable .ZIP-Archive, die strikt über das Android Storage Access Framework (SAF) in einen von Ihnen gewählten lokalen Ordner oder auf ein externes Laufwerk exportiert werden.</string>
    <string name="privacy_understood">Verstanden</string>

