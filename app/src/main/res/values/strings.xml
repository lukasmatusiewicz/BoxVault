    <!-- Offline Privacy Policy Dialog -->
    <string name="privacy_title">100% Offline Privacy Architecture</string>
    <string name="privacy_summary">BoxVault is engineered from the ground up with zero cloud dependencies. Your inventory data is strictly your property and never leaves your physical device.</string>
    <string name="privacy_pillar_db_title">100% Local On-Device SQLite Database</string>
    <string name="privacy_pillar_db_desc">Every box, item quantity, category, and photo reference is stored exclusively in your app-private local Room SQLite database on your device storage.</string>
    <string name="privacy_pillar_network_title">Zero Network Permissions</string>
    <string name="privacy_pillar_network_desc">android.permission.INTERNET is strictly removed (tools:node=\"remove\") in AndroidManifest.xml. The Android operating system physically forbids BoxVault from making any outbound network connections.</string>
    <string name="privacy_pillar_accounts_title">No Accounts, Tracking, or Cloud Sync</string>
    <string name="privacy_pillar_accounts_desc">No email registrations, no passwords, no cloud accounts, and zero telemetry/analytics SDKs. QR scanner uses bundled offline ML Kit models.</string>
    <string name="privacy_pillar_backup_title">Private Local SAF Archive Backups</string>
    <string name="privacy_pillar_backup_desc">Backups are portable .ZIP archives exported strictly through Android\'s Storage Access Framework (SAF) to a local folder or external drive you select.</string>
    <string name="privacy_understood">Understood</string>

