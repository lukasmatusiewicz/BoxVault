    <!-- Backup & Restore Screen -->
    <string name="backup_title">Local ZIP Backup &amp; Restore</string>
    <string name="backup_subtitle">100% Offline SAF Archive • SHA-256 &amp; Zip-Slip Protected</string>
    <string name="backup_processing_staging">Processing archive in isolated staging directory...</string>
    <string name="backup_inventory_title">Current On-Device Vault Inventory</string>
