    <string name="backup_export_desc">Includes backup_manifest.json + all photos with SHA-256 checksums</string>
    <string name="backup_export_btn">Export .ZIP Archive via SAF</string>
    <string name="backup_restore_title">Restore from Local .ZIP Archive</string>
    <string name="backup_restore_desc">Extracts &amp; verifies inside cacheDir/restore_staging before touching live data</string>
    <string name="backup_restore_btn">Select .ZIP Backup to Restore</string>
    <string name="backup_security_title">Cryptographic &amp; Archive Security Guarantees</string>
    <string name="backup_sec_zipslip_title">Strict Zip-Slip Path Traversal Defense</string>
    <string name="backup_sec_zipslip_desc">Every ZipEntry is canonically validated inside cacheDir/restore_staging. Entries containing \'..\' or escaping the staging root throw SecurityException.</string>
    <string name="backup_sec_sha_title">Atomic Staged SHA-256 Verification</string>
    <string name="backup_sec_sha_desc">Every staged photo is hashed with SHA-256 and verified against backup_manifest.json before any live Room row or photo file is overwritten.</string>
    <string name="backup_sec_cloud_title">Zero Cloud / Zero Network Permissions</string>
    <string name="backup_sec_cloud_desc">android:allowBackup=\"false\" and tools:node=\"remove\" on INTERNET ensure backups only move where you explicitly save them via Android SAF.</string>
    <string name="backup_dialog_title">Restore Backup Archive?</string>
    <string name="backup_dialog_message">BoxVault will first extract and verify all SHA-256 photo checksums inside an isolated staging folder. Only if 100% of integrity checks pass will your current on-device inventory be replaced.</string>
    <string name="backup_dialog_confirm">Verify &amp; Restore</string>

