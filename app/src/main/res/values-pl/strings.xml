    <!-- Offline Privacy Policy Dialog -->
    <string name="privacy_title">W 100% lokalna ochrona prywatności</string>
    <string name="privacy_summary">BoxVault został zaprojektowany od podstaw z zerową zależnością od chmury. Twoje dane magazynowe są wyłącznie Twoją własnością i nigdy nie opuszczają urządzenia.</string>
    <string name="privacy_pillar_db_title">W 100% lokalna baza danych SQLite na urządzeniu</string>
    <string name="privacy_pillar_db_desc">Każde pudełko, ilość przedmiotów, kategoria i referencja do zdjęć są przechowywane wyłącznie w prywatnej lokalnej bazie Room SQLite w pamięci urządzenia.</string>
    <string name="privacy_pillar_network_title">Zero uprawnień sieciowych</string>
    <string name="privacy_pillar_network_desc">Uprawnienie android.permission.INTERNET zostało usunięte (tools:node=\"remove\") w AndroidManifest.xml. System Android uniemożliwia aplikacji nawiązywanie jakichkolwiek połączeń wychodzących.</string>
    <string name="privacy_pillar_accounts_title">Brak kont, śledzenia i synchronizacji z chmurą</string>
    <string name="privacy_pillar_accounts_desc">Bez rejestracji e-mail, haseł, kont w chmurze i telemetrii. Skaner QR korzysta z wbudowanych offline modeli ML Kit.</string>
    <string name="privacy_pillar_backup_title">Prywatne kopie zapasowe SAF</string>
    <string name="privacy_pillar_backup_desc">Kopie zapasowe to przenośne archiwa .ZIP eksportowane wyłącznie przez Android Storage Access Framework (SAF) do wybranego folderu lub dysku.</string>
    <string name="privacy_understood">Rozumiem</string>

